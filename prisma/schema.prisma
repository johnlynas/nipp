// ============================================================
// TENANT ISOLATION REQUIREMENT
// ============================================================
// Every organization-scoped model MUST include:
//
//   organizationId String
//   organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
//   @@index([organizationId])
//
// (BetterAuth-owned models — Member, Invitation, SentInvitation — use `orgId`.)
// This is required for BOTH isolation layers:
//   1. App layer: tenantDb extension (lib/tenant-db.ts / lib/tenant-extension-core.ts)
//      injects the org column into where/data — its model list must match this
//      requirement exactly (drift-guarded by tests/unit/tenant-db-hardening.test.ts).
//   2. DB layer: PostgreSQL RLS policies (prisma/migrations/…_rls_complete_policies)
//      keyed on the same column; policy catalog drift is hash-checked in CI
//      (tests/isolation/database/policy-catalog.golden).
//
// Without an org column, tenant isolation is BROKEN for that model.
//
// EXEMPT models (global — no org column by design, documented in SECURITY.md
// Appendix B / documents/rls-complete-implementation.md §3.3):
//   User, Session, Account        BetterAuth auth models (no tenant data)
//   Permission                    global catalog; read restricted to platform org
//                                 OR permissions assigned to the ctx org's roles
//   Resource, ResourceRole        global feature catalog; the sensitive side sits
//                                 on org-scoped Role rows which ARE policied.
//                                 Re-evaluate before any route queries these directly.
//   JobDefinition, JobExecution   platform-only by strongest stance: policies gate
//                                 on app.is_platform_admin AND app.platform_org_id =
//                                 the row's platformOrgId (no tenant-context path).
//   Organization, AuditLog, NotificationLog, Notification  RLS-only tables with
//                                 richer per-command/NULL-org visibility rules —
//                                 policies exist; they have no single-column app
//                                 layer injection.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

/** Organization lifecycle states */
enum OrgStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/** Notification delivery status */
enum NotificationStatus {
  SENT
  FAILED
}

/** Calendar event types */
enum CalendarEventType {
  VIEWING
  INSPECTION
  MAINTENANCE
  LEASE_SIGNING
  LEASE_RENEWAL
  KEY_EXCHANGE
  OTHER
}

/** Recurrence frequency for recurring calendar events (used by frontend/display helpers). */
enum CalendarRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

/** Notification scope — who receives the notification */
enum NotificationScope {
  GLOBAL
  ORG
}

/**
 * Notification priority levels.
 *
 * CALENDAR is the priority for "event due to start" SSE notifications emitted
 * by lib/calendar-event-scheduler.ts. It behaves like CRITICAL in the ticker:
 * it persists until the user dismisses it manually (it does NOT auto-dismiss
 * like INFO/WARNING). It is rendered in bright green to distinguish upcoming
 * calendar reminders from operational alerts.
 */
enum NotificationPriority {
  INFO
  WARNING
  ERROR
  CRITICAL
  CALENDAR
  JOB
}

// ============================================================
// Authentication Models (BetterAuth — global, not org-scoped)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  passwordHash  String?
  role          String    @default("member")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  activeOrganizationId  String?   @map("activeOrganizationId")
  // Design §4.3: true only when the user completes magic-link verification.
  // emailVerified is asserted by Google on sign-up and CANNOT be used for this.
  oidcVerified          Boolean   @default(false)

  sessions Session[]
  accounts Account[]
  members  Member[]
  teamMembers TeamMember[] // User can be a member of multiple teams
}

model Session {
  id           String    @id @default(cuid())
  expiresAt    DateTime
  token        String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ipAddress    String?
  userAgent    String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String    @id @default(cuid())
  // NOTE: field names MUST match BetterAuth's canonical account schema — the
  // prisma adapter passes them through verbatim (providerId + accountId where
  // accountId = provider-specific sub, accessToken/idToken/… camelCase). Do not
  // rename without re-pointing better-auth/adapters/prisma.
  accountId         String
  providerId        String
  password          String?
  refreshTokenExpiresAt DateTime?
  idToken           String?
  scope             String?
  tokenType         String?
  sessionState      String?
  accessToken     String?
  accessTokenExpiresAt DateTime?
  refreshToken    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// BetterAuth verification records (email verifications, OAuth state storage).
// Required by the social-provider sign-in flow (OAuth PKCE state + nonce).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ============================================================
// Multi-Tenancy Models (BetterAuth Organization Plugin)
// These are global — not org-scoped.
// ============================================================

model Organization {
  id          String   @id @default(cuid())
  slug        String?  @unique
  name        String
  description String?
  status      OrgStatus @default(PENDING)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members            Member[]
  invitations        Invitation[]
  sentInvitations    SentInvitation[]
  memberRoles        MemberRole[]
  auditLogs          AuditLog[]
  notificationLogs   NotificationLog[]
  notifications      Notification[]
  // RBAC: roles and role-permission mappings scoped to this organization
  roles              Role[]
  rolePermissions    RolePermission[]
  // Teams: sub-organizational groupings with role inheritance
  teams              Team[]
  teamMembers        TeamMember[] // Organization-scoped team memberships
  teamRoles          TeamRole[]   // Organization-scoped team-role assignments
  // Calendars: organization-scoped calendar containers and events
  calendars          Calendar[]
  calendarEvents     CalendarEvent[]
}

model Member {
  id         String   @id @default(cuid())
  role       String   @default("member")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberRoles MemberRole[]

  // Optional team association (BetterAuth internal alignment when teams are enabled)
  teamId     String?  @map("teamId")

  @@unique([userId, orgId])
}

model Invitation {
  id         String   @id @default(cuid())
  email      String
  role       String?
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  orgId      String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Optional team association — invites users directly to a specific team
  teamId     String?  @map("teamId")

  @@index([email])
}

// ============================================================
// Teams Models (BetterAuth Organization Plugin — Teams Mode)
// These are organization-scoped for tenant isolation.
// ============================================================

/**
 * Team — Functional grouping within an organization.
 * Teams allow users to be organized into sub-organizational units
 * (e.g., "Maintenance Team A", "Letting Agents") with role inheritance.
 */
model Team {
  id          String   @id @default(cuid())
  name        String   // Human-readable team name (max 100 chars)
  slug        String?  // URL-friendly identifier (auto-generated from name if not provided)
  description String?  // Optional team description (max 500 chars)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members TeamMember[]
  roles  TeamRole[]

  @@unique([organizationId, slug]) // Slug is unique per organization
  @@index([organizationId, name]) // B-tree index for efficient org-scoped team lookups
  @@index([slug])                 // Index for unique slug resolution
}

/**
 * TeamMember — User-to-team membership within an organization.
 * A user can be a member of multiple teams within the same org.
 */
model TeamMember {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId]) // A user can only be in a team once
  @@index([organizationId])  // Index for tenant-scoped queries
  @@index([teamId])          // Index for team member lookups
}

/**
 * TeamRole — Junction table linking teams to organization-scoped roles.
 * Enables automatic role inheritance: when a user joins a team,
 * all roles associated with that team are automatically assigned.
 */
model TeamRole {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([teamId, roleId]) // A role can only be assigned once per team
  @@index([organizationId])  // Index for tenant-scoped queries
}

// SentInvitation (BetterAuth internal model for tracking sent invitations)
model SentInvitation {
  id         String   @id @default(cuid())
  email      String
  role       String?
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  orgId      String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([email])
}

// ============================================================
// RBAC Models (Authorization & Role-Based Access Control)
// ============================================================

/**
 * Permission — Global master catalog of all available permissions.
 * Uses resource:action syntax (e.g., properties:view, tenants:create).
 * Global because the permission catalog is shared across all organizations.
 */
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "properties:view"
  resource    String   // e.g., "properties"
  action      String   // e.g., "view"
  description String?
  isDefault   Boolean  @default(true) // true = bootstrapped, false = custom
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       RolePermission[]
}

/**
 * Role — Organization-scoped role definition.
 * Roles can be default (bootstrapped) or custom (created by Org Admins).
 */
model Role {
  id          String   @id @default(cuid())
  name        String   // e.g., "Property Manager", "Custom Viewer"
  description String?
  isDefault   Boolean  @default(false) // true = bootstrapped, false = custom
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  permissions        RolePermission[]
  memberRoles        MemberRole[]
  teamRoles          TeamRole[]   // Roles assigned to teams for inheritance
  // Resource access control — global junction table back-reference
  resources          ResourceRole[]

  @@index([name]) // B-tree index for prefix search (search-autocomplete)
}

/**
 * RolePermission — Junction table mapping roles to permissions.
 * Org-scoped for tenant isolation (redundant with Role.organizationId but required by schema rules).
 */
model RolePermission {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([organizationId])
}

/**
 * MemberRole — Junction table linking members to their assigned roles.
 * Fixes pre-existing bug: this table was referenced in code (org-bootstrap.ts)
 * but missing from the schema. Org-scoped for tenant isolation.
 */
model MemberRole {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([organizationId])
}


/**
 * AuditLog — Records security-relevant admin actions for all organizations.
 * Global model (not org-scoped) so Super Admins can query across tenants.
 */
model AuditLog {
  id             String       @id @default(cuid())
  timestamp      DateTime     @default(now())
  userId         String?
  userName       String?
  action         String       // e.g., "organization.created", "role.deleted"
  resourceType   String       // e.g., "Organization", "Role", "Permission"
  resourceId     String?
  organizationId String?
  ipAddress      String?
  userAgent      String?
  success        Boolean      @default(true)
  metadata       Json?

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([timestamp])
  @@index([resourceType])
}

/**
 * NotificationLog — Tracks email notifications sent by the notification system.
 */
model NotificationLog {
  id               String         @id @default(cuid())
  timestamp        DateTime       @default(now())
  recipientEmail   String
  eventType        String
  message          String?
  status           NotificationStatus @default(SENT)
  organizationId   String?

  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([timestamp])
}

// ============================================================
// Notification Models (In-app notifications — org-scoped + global)
// ============================================================

/**
 * Notification — In-app events surfaced via SSE stream + notification log.
 *
 * Scope semantics (see lib/notification-push.ts, pushNotification):
 *   - GLOBAL: broadcast to ALL connected subscribers (super admins and every
 *     tenant). organizationId is intentionally NULL for pure broadcasts, but
 *     an ADMIN global broadcast sent on behalf of an org (source
 *     "admin:message") may carry that org's id so the log can display which
 *     organization initiated it.
 *   - ORG: delivered only to subscribers of that organization plus super
 *     admins (whose subscriber orgId is NULL).
 *
 * Super admins can view every notification regardless of scope — scope gates
 * live SSE delivery, not historical visibility in the admin log.
 */
model Notification {
  id             String   @id @default(cuid())
  title          String
  message        String
  priority       NotificationPriority @default(INFO)
  scope          NotificationScope @default(ORG) // ORG = tenant-specific, GLOBAL = broadcast to all
  source         String?  // e.g., "health-check:database", "admin:message", "platform:certs"

  /** Organization this notification belongs to (null for global broadcasts) */
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /** Whether this notification has been acknowledged by an admin */
  acknowledged   Boolean  @default(false)

  @@index([organizationId])
  @@index([createdAt])
  @@index([scope, createdAt]) // For admin log listing (global notification queries)
}

// ============================================================
// Resource Data Model (Global — not org-scoped)
// ============================================================

/**
 * Resource — Global catalog of portal feature modules.
 * Resources represent feature areas (e.g., "Maintenance Requests", "Work Orders")
 * and are linked to org-scoped roles via the ResourceRole junction table.
 */
model Resource {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resourceRoles ResourceRole[]
}

/**
 * ResourceRole — Global junction table linking Resources to org-scoped Roles.
 * Enables feature-level access control: a role must be assigned to a resource
 * for users with that role to access the feature.
 */
model ResourceRole {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([resourceId, roleId]) // A role can only be assigned once per resource
}

// ============================================================
// Calendar Models (Interactive Calendar — org-scoped)
// ============================================================

/**
 * Calendar — Container/namespace for events within an organization.
 * Each org gets one default calendar at bootstrap. Supports multiple calendars
 * per org for future extensibility (e.g., "Maintenance Calendar", "Lettings Calendar").
 */
model Calendar {
  id          String   @id @default(cuid())
  name        String   // Human-readable calendar name
  description String?
  color       String   @default("#1B2A4A") // Default color theme
  isDefault   Boolean  @default(false) // Exactly one default calendar per org
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  events CalendarEvent[]

  @@unique([organizationId, name]) // Prevent duplicate names within an org
  @@index([organizationId])
}

/**
 * CalendarEvent — Individual events within a calendar.
 * Supports single-day, multi-day, and recurring events via rrule JSON.
 */
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime // Local datetime (no timezone for v1)
  endDate     DateTime // Local datetime (no timezone for v1)
  eventType   CalendarEventType @default(OTHER)
  color       String?  // Event-level override of calendar default color

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  /** RFC 5545 recurrence rule stored as JSON (rrule format). */
  rrule        Json?
  /** Excluded dates from expansion (YYYY-MM-DD strings). */
  exdates      Json @default("[]") @db.Json

  propertyId String? // Optional property association (nullable for general events)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId, startDate]) // Efficient date range queries
  @@index([propertyId])                 // Property-based event lookups (future scheduler)
}

// ============================================================
// Background Job Scheduler (job-scheduler-service)
// Platform-organization only. A job run forks a Bree worker; operator code
// (Phase 2) is stored in `code` and materialized to a tmp file at exec time
// (file-based worker — never eval'd).
// ============================================================

model JobDefinition {
  id             String  @id @default(cuid())
  /** Owner = the platform organization only. */
  platformOrgId  String

  /** Unique within a platformOrgId. */
  name           String
  /** Free-text description of what the script does. */
  description    String?
  /** Handler registry key → built-in handler or (Phase 2) stored script. */
  handlerKey     String
  /**
   * Operator/script source (Phase 2). Materialized to a tmp file under
   * job-scheduler-runtime/ at execution time and loaded into the Bree worker
   * by file path — never stringified/eval'd. Null for built-in handlers.
  */
  code           String?
  /** Schedule: JSON — { 'kind': 'cron'|'interval'|'oneshot', ... }. */
  scheduleExpr   String
  /** IANA timezone; default from JOB_SCHEDULER_TIMEZONE. */
  timezone       String?
  /** Per-job wall-clock cap (ms); default from JOB_SCHEDULER_DEFAULT_TIMEOUT_MS. */
  timeoutMs      Int?
  /** Per-job concurrency limit (default from JOB_SCHEDULER_DEFAULT_CONCURRENCY (1). */
  concurrencyLimit Int?   @default(1)
  enabled        Boolean @default(false)

   /**
    * Approval gate — a job cannot be enabled, triggered, or run on its schedule
    * until a platform admin explicitly approves it. Phase 1 runs this as a
    * general guardrail so a newly created job (including one that will later
    * carry operator-authored `code`) never executes unreviewed.
    */
  approved     Boolean @default(false)
   /** Platform admin user id who approved this job (null until approved). */
  approvedBy   String?
   /** When the job was last approved. */
  approvedAt   DateTime?
   /** Optional note recorded on approval/rejection. */
  approvalNote String?

   /** Idempotency marker — doubles as the claim gate for overlapping/restart runs. */
  lastRunAt      DateTime?
   /** SUCCEEDED | FAILED | CANCELLED */
  lastRunStatus  String?

   /** Platform admin user id who created this job. */
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  executions     JobExecution[]

   @@unique([platformOrgId, name])
   @@index([platformOrgId, enabled])
   @@index([platformOrgId, lastRunAt])
   @@index([platformOrgId, approved])
}

model JobExecution {
  id              String  @id @default(cuid())
  jobDefinitionId String
  platformOrgId   String

  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  /** PENDING | RUNNING | SUCCEEDED | FAILED | CANCELLED */
  status          String
  /** SCHEDULE | MANUAL */
  trigger         String
  /** Who triggered a manual run. */
  actorId         String?
  error           String?
  resultJson      Json?
  /** Always 'job-scheduler:execution'. */
  source          String

  createdAt       DateTime @default(now())

  jobDefinition   JobDefinition @relation(fields: [jobDefinitionId], references: [id], onDelete: Cascade)

  @@index([jobDefinitionId, startedAt])
  @@index([platformOrgId, status])
}
