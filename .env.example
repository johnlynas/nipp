# =======================================================================
# Property NI Multi-Tenant Portal — Local Developer Environment Variables
# =======================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets to version control.
# =======================================================================

# If not using pgbouncer connection polling: Database — PostgreSQL connection string (Injected by hosting platform in production)
# DATABASE_URL="postgresql://postgres@localhost:5432/nipp_dev"

# If using pgbouncer connection pooling: Database — PostgreSQL connection string (use production-grade credentials)
DATABASE_URL="postgresql://postgres:<pg password>@localhost:6432/nipp_dev?pgbouncer=true&connection_limit=10&pool_timeout=30&query_timeout=30&client_idle_timeout=120&server_lifetime=3600"
PGBOUNCER_PASSWORD="your-pgbouncer-password"

# BetterAuth — Session encryption secret (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-super-secret-key-change-in-production"

# Google OIDC — Register at https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# PII Encryption — AES-256-GCM key (32 bytes, hex-encoded)
# Generate with: openssl rand -hex 32
PII_ENCRYPTION_KEY="your-pii-encryption-key"

# Logging — debug | info | warn | error
LOG_LEVEL="debug"

# Inactivity Timeout (minutes) — auto-logout after this period of no user activity
INACTIVITY_TIMEOUT_MINS="15"

# BetterAuth — Base URL for sessions and callbacks
BETTER_AUTH_URL="http://localhost:3000"

# Application URLs
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Redis — Permission caching (set when Redis is available)
REDIS_URL="redis://localhost:6379"

# SMTP — Email notifications for extreme events
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="nipp admin email address>"

# Payload Encryption — Application-layer PII payload encryption (defense-in-depth)
PAYLOAD_ENCRYPTION_MODE="disabled"          # disabled | permissive | enforce
PAYLOAD_ENCRYPTION_MAX_BYTES="65536"        # Maximum encrypted payload size in bytes
PAYLOAD_ENCRYPTION_KEY_TTL_SECONDS="300"    # Payload key lifetime in seconds
PAYLOAD_ENCRYPTION_REPLAY_WINDOW_SECONDS="30"  # Replay protection window in seconds
PAYLOAD_ENCRYPTION_NONCE_TTL_SECONDS="60"   # Replay nonce cache TTL in seconds
PAYLOAD_ENCRYPTION_REPLAY_CACHE="redis"     # memory | redis — backend for replay nonce deduplication
PAYLOAD_ENCRYPTION_REQUIRE_REPLAY_CACHE="false"  # true | false — fail closed if replay cache unavailable (enforce mode)

# ============================================================
# CREDENTIALS (DO NOT COMMIT)
# ============================================================
# The seed script requires these to be set in your LOCAL .env file or as environment variables
# They are intentionally omitted from shared templates for security.
#
# ADMIN_EMAIL="your-local-admin@nipp.gov.uk"
# ADMIN_PASSWORD="YourSecureLocalPassword123"

# Developer Profile Seeding (dev mode — default)
# Platform user credentials are driven by ADMIN_EMAIL/ADMIN_PASSWORD above.
# DEV_TENANT_A_EMAIL="dev-tenant-a@example.com"
# DEV_TENANT_A_PASSWORD="DevTenantA123!"
# DEV_TENANT_B_EMAIL="dev-tenant-b@example.com"
# DEV_TENANT_B_PASSWORD="DevTenantB123!"

# Testing Profile Seeding (test mode — set TEST_ADMIN_EMAIL to activate)
# TEST_ADMIN_EMAIL="platform-test@nipp.gov.uk"
# TEST_ADMIN_PASSWORD="TestPlatformPassword123!"
# TEST_TENANT_A_EMAIL="test-tenant-a@example.com"
# TEST_TENANT_A_PASSWORD="TestTenantA123!"
# TEST_TENANT_B_EMAIL="test-tenant-b@example.com"
# TEST_TENANT_B_PASSWORD="TestTenantB123!"
# PII_ENCRYPTION_KEY="YourPIIEncryptionKey"
# PGBOUNCER_PASSWORD="YourPgBouncerPassword"
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# BETTER_AUTH_SECRET="your-super-secret-key-change-in-production"
# PLATFORM_ORG_ID="" (Optional: The seed script and lib/rls.ts will find it automatically if missing)
# PAYLOAD_ENCRYPTION_MODE="disabled"          # disabled | permissive | enforce
# PAYLOAD_ENCRYPTION_MAX_BYTES="65536"        # Maximum encrypted payload size in bytes
# PAYLOAD_ENCRYPTION_KEY_TTL_SECONDS="300"    # Payload key lifetime in seconds
# PAYLOAD_ENCRYPTION_REPLAY_WINDOW_SECONDS="30"  # Replay protection window in seconds
# PAYLOAD_ENCRYPTION_NONCE_TTL_SECONDS="60"   # Replay nonce cache TTL in seconds
# PAYLOAD_ENCRYPTION_REPLAY_CACHE="redis"     # memory | redis — backend for replay nonce deduplication
# PAYLOAD_ENCRYPTION_REQUIRE_REPLAY_CACHE="false"  # true | false — fail closed if replay cache unavailable (enforce mode)

# ============================================================
# RATE LIMITING — optional overrides, sensible defaults apply
# ============================================================
# Auth endpoints (login/register) — by IP address
RATE_LIMIT_AUTH_MAX="5"                    # max requests per window (default 5)
RATE_LIMIT_AUTH_WINDOW="60"                # window duration in seconds (default 60)

# Admin write endpoints — by session ID
RATE_LIMIT_ADMIN_MAX="30"                  # max requests per window (default 30)
RATE_LIMIT_ADMIN_WINDOW="60"               # window duration in seconds (default 60)

# Calendar CRUD endpoints — by session ID
RATE_LIMIT_CALENDAR_MAX="30"               # max requests per window (default 30)
RATE_LIMIT_CALENDAR_WINDOW="60"             # window duration in seconds (default 60)

# ============================================================
# Background Job Scheduler (job-scheduler-service / Bree)
# Platform-organization only.
# ============================================================
# Master on/off for the job scheduler engine
JOB_SCHEDULER_ENABLED="true"                # true | false
# Default IANA timezone for schedules
JOB_SCHEDULER_TIMEZONE="Europe/London"
# Global cap on simultaneous job runs (circuit breaker)
JOB_SCHEDULER_MAX_CONCURRENT="5"           # max concurrent job runs across all jobs
# Connection-pool ceiling per forked worker (sized BELOW PgBouncer max_client_conn)
JOB_SCHEDULER_DB_CONCURRENCY="100"
# Per-job default concurrency limit
JOB_SCHEDULER_DEFAULT_CONCURRENCY="1"
# Per-job default wall-clock cap (ms)
JOB_SCHEDULER_DEFAULT_TIMEOUT_MS="300000"  # 5 minutes
# Load enabled jobs from the DB at boot
JOB_SCHEDULER_BOOT_REGISTRY="true"         # true | false
# New jobs default to dry-run until approved (Phase 2)
JOB_SCHEDULER_DRYRUN_DEFAULT="false"       # true | false
# ============================================================