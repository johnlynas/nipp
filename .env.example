# ============================================================
# Property NI Multi-Tenant Portal — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets to version control.
# ============================================================

# Database — PostgreSQL connection string (Injected by hosting platform in production)
DATABASE_URL="postgresql://postgres@localhost:5432/nipp_dev"

# BetterAuth — Session encryption secret (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-super-secret-key-change-in-production"

# Google OIDC — Register at https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# PII Encryption — AES-256-GCM key (32 bytes, hex-encoded)
# Generate with: openssl rand -hex 32
PII_ENCRYPTION_KEY="d96eff6fb8c8d60293aac6ba9c85346abb38c63ba4480c7a7e949b7aa39d1f96"

# Logging — debug | info | warn | error
LOG_LEVEL="debug"

# BetterAuth — Base URL for sessions and callbacks
BETTER_AUTH_URL="http://localhost:3000"

# Application URLs
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Redis — Permission caching (set when Redis is available)
REDIS_URL="redis://localhost:6379"

# SMTP — Email notifications for extreme events
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@nipp.gov.uk"

# ============================================================
# LOCAL DEVELOPER CREDENTIALS (DO NOT COMMIT)
# ============================================================
# The seed script requires these to be set in your LOCAL .env file.
# They are intentionally omitted from shared templates for security.
#
# ADMIN_EMAIL="your-local-admin@nipp.gov.uk"
# ADMIN_PASSWORD="YourSecureLocalPassword123"
# PLATFORM_ORG_ID="" (Optional: The seed script and lib/rls.ts will find it automatically if missing)
# ============================================================