{
  "name": "nipp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --skip-seed",
    "db:seed": "tsx prisma/seed.ts",
    "build:cloud": "echo 'Placeholder — configure cloud build'",
    "deploy:cloud": "echo 'Placeholder — configure cloud deploy'",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/isolation",
    "test:all": "vitest run",
    "test:watch": "vitest tests/unit",
    "test:coverage": "vitest run tests/unit --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.6.0",
    "ioredis": "^5.11.1",
    "next": "^15.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@better-auth/test-utils": "^1.6.23",
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.5"
