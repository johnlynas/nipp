{
  "name": "nipp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --skip-seed",
    "db:seed": "node scripts/seed.js",
    "build:cloud": "echo 'Placeholder — configure cloud build'",
    "deploy:cloud": "echo 'Placeholder — configure cloud deploy'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:auth": "vitest run tests/unit/auth.test.ts",
    "test:organization": "vitest run tests/unit/organization.test.ts"
  },
  "dependencies": {
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prisma/client": "^6.5.0",
    "better-auth": "^1.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",

    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",

    "typescript": "^5.7.0",
    "@tailwindcss/typography": "^0.5.15",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "prisma": "^6.5.0",
    "@better-auth/test-utils": "^1.6.23",
    "vitest": "^4.1.5",
    "@testing-library/react": "^16.2.0",
    "jsdom": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.21.0",
    "@eslint/js": "^9.21.0",
    "typescript-eslint": "^8.24.0",
    "eslint-config-next": "^15.2.0",
    "prettier": "^3.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0"
  }
}
