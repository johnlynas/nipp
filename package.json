{
  "name": "nipp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "patch-package",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/lint-guardrails.mjs",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "build:cloud": "echo 'Placeholder — configure cloud build'",
    "deploy:cloud": "echo 'Placeholder — configure cloud deploy'",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/isolation",
    "test:all": "vitest run",
    "test:watch": "vitest tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:isolation": "bash -c 'npm run test:isolation:db && npm run test:isolation:setup && npm run test:isolation:app && npm run test:isolation:e2e && npm run test:isolation:teardown'",
    "test:isolation:setup": "bash scripts/setup-test-env.sh",
    "test:isolation:teardown": "bash scripts/teardown-test-env.sh",
    "test:isolation:app": "vitest run tests/isolation/application/",
    "test:isolation:e2e": "playwright test tests/isolation/e2e/ --config=tests/isolation/playwright.config.ts",
    "test:isolation:db": "vitest run tests/isolation/database/ --config vitest.db.config.ts",
    "db:gen-policy-golden": "tsx scripts/rls-gen-policy-golden.ts",
    "docs:generate": "tsx scripts/generate-openapi.mjs",
    "test:rls-perf": "bash -c 'npx tsx scripts/rls-perf-benchmark.ts'"
  },
  "dependencies": {
    "@better-auth/core": "1.7.14",
    "@breejs/later": "^4.2.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "1.7.14",
    "bree": "^9.2.9",
    "graceful": "^2.0.0",
    "ioredis": "^5.11.1",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.34.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rrule": "^2.8.1",
    "sonner": "^2.0.7",
    "swagger-ui-dist": "^5.33.0",
    "zod": "^4.0.0",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@better-auth/test-utils": "1.7.14",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/google.maps": "^3.66.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.21.0",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5",
    "minimatch": "^11.0.1"
  }
}
