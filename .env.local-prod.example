# ============================================================
# Property NI Multi-Tenant Portal — Local Production Environment
# ============================================================
# Copy this file to .env.local-prod and fill in real values.
# NEVER commit .env.local-prod to version control.
# ============================================================

# If not using pgbouncer connection pooling: Database — PostgreSQL connection string (use production-grade credentials)
# DATABASE_URL="postgresql://user:strong-password@localhost:5432/nipp_prod"

# If using pgbouncer connection pooling: Database — PostgreSQL connection string (use production-grade credentials)
DATABASE_URL="postgresql://postgres:<pg password>@localhost:6432/nipp_dev?pgbouncer=true&connection_limit=10&pool_timeout=30&query_timeout=30&client_idle_timeout=120&server_lifetime=3600"
PGBOUNCER_PASSWORD="your-pgbouncer-password"

# BetterAuth — Session encryption secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-super-secret-key-change-in-production"

# BetterAuth — Base URL for sessions and callbacks
BETTER_AUTH_URL="https://<hostname>:3000"

# Google OIDC — Register at https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# PII Encryption — AES-256-GCM key (32 bytes, hex-encoded)
# Generate with: openssl rand -hex 32
PII_ENCRYPTION_KEY="your-32-character-aes-256-key-here"

# Logging — info | warn | error (avoid debug in production)
LOG_LEVEL="info"

# Inactivity Timeout (minutes) — auto-logout after this period of no user activity
INACTIVITY_TIMEOUT_MINS="15"

# Application URLs
FRONTEND_URL="https://<hostname>:3000"
NEXT_PUBLIC_API_URL="https://<hostname>:3000"

# TLS Certificates — Self-signed for local-prod HTTPS
TLS_CERT_PATH="./certs/cert.pem"
TLS_KEY_PATH="./certs/key.pem"

# ============================================================
#  CREDENTIALS (DO NOT COMMIT)
# ============================================================
# The seed script requires these to be set in your LOCAL .env file or as exported environment variables
# They are intentionally omitted from shared templates for security.
#
# In a full production cloud deployment the application secrets will be stored in a secrets manager 
# will only be visible to the application as exported environment variables
#
# ADMIN_EMAIL="your-local-admin@nipp.gov.uk"
# ADMIN_PASSWORD="YourSecureLocalPassword123"
# PII_ENCRYPTION_KEY="YourPIIEncryptionKey"
# PGBOUNCER_PASSWORD="YourPgBouncerPassword"
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# BETTER_AUTH_SECRET="your-super-secret-key-change-in-production"
# PLATFORM_ORG_ID="" (Optional: The seed script and lib/rls.ts will find it automatically if missing)
# ============================================================