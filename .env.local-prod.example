# ============================================================
# Property NI Multi-Tenant Portal — Local Production Environment
# ============================================================
# Copy this file to .env.local-prod and fill in real values.
# NEVER commit .env.local-prod to version control.
# ============================================================

# Database — PostgreSQL connection string (use production-grade credentials)
DATABASE_URL="postgresql://user:strong-password@localhost:5432/nipp_prod"

# BetterAuth — Session encryption secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-super-secret-key-change-in-production"

# Google OIDC — Register at https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# PII Encryption — AES-256-GCM key (32 bytes, hex-encoded)
PII_ENCRYPTION_KEY="your-32-character-aes-256-key-here"

# Logging — info | warn | error (avoid debug in production)
LOG_LEVEL="info"

# Application URLs
FRONTEND_URL="https://localhost:3000"
NEXT_PUBLIC_API_URL="https://localhost:3000"

# TLS Certificates — Self-signed for local-prod HTTPS
TLS_CERT_PATH="./certs/cert.pem"
TLS_KEY_PATH="./certs/key.pem"
