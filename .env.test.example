# ============================================================
# Property NI — Test Environment Variables (Example)
# ============================================================
# Copy this file to .env.test and fill in real values.
# NEVER commit .env.test to version control (it is in .gitignore).
# ============================================================

# Test database connection — pgbouncer on port 6433 (avoids conflict with homebrew pgbouncer on 6432)
# Uses postgres superuser (postgres) — pgbouncer forwards to backend as postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:6433/nipp_test?pgbouncer=true"

# BetterAuth — Session encryption secret (must be ≥ 32 chars)
BETTER_AUTH_SECRET="test-secret-key-change-me-32chars-min"

# Test user credentials — Super Admin
TEST_ADMIN_EMAIL="superadmin@example.com"
TEST_ADMIN_PASSWORD="SuperAdmin123!"

# Test user credentials — OrgA (Acme Properties Ltd)
TEST_TENANT_A_EMAIL="orga-tenant@example.com"
TEST_TENANT_A_PASSWORD="TenantA123!"

# Test user credentials — OrgB (Belfast Rentals)
TEST_TENANT_B_EMAIL="orgb-tenant@example.com"
TEST_TENANT_B_PASSWORD="TenantB123!"

# Application URLs
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# BetterAuth — Base URL for sessions and callbacks
BETTER_AUTH_URL="http://localhost:3000"

# PgBouncer auth (required by env validation)
PGBOUNCER_PASSWORD="test"

# Google OAuth (placeholder — not used in tests)
GOOGLE_CLIENT_ID="test"
GOOGLE_CLIENT_SECRET="test"

# PII encryption (placeholder — 64 hex chars)
PII_ENCRYPTION_KEY="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Logging
LOG_LEVEL="info"

# Inactivity Timeout (minutes)
INACTIVITY_TIMEOUT_MINS="15"
